{:paths   ["src" "resources"]
 :deps    {org.clojure/clojure            {:mvn/version "1.12.5"}
           io.pedestal/pedestal.service   {:mvn/version "0.8.2-beta-10"}
           io.pedestal/pedestal.jetty     {:mvn/version "0.8.2-beta-10"}
           clj-rss/clj-rss                {:mvn/version "0.4.0"}
           datalevin/datalevin            {:mvn/version "0.10.18"}
           io.github.nextjournal/markdown {:mvn/version "0.7.225"}
           com.nextjournal/beholder       {:mvn/version "1.0.3"}
           com.github.rawleyfowler/sluj   {:mvn/version "1.0.2"}
           tick/tick                      {:mvn/version "1.0.1"}
           no.cjohansen/replicant         {:mvn/version "2026.06.2"}
           com.taoensso/telemere          {:mvn/version "1.2.1"}
           ;; SLF4J v2 backend: routes Datalevin/Jetty/Pedestal logging into Telemere.
           com.taoensso/telemere-slf4j    {:mvn/version "1.2.1"}
           dk.cst/hiccup-tools            {:git/url "https://github.com/kuhumcst/hiccup-tools.git"
                                           :git/sha "c0b84e101e6edd8dee69935f8623908f23b5fcd8"}
           ;; Already on the classpath via nextjournal/markdown; declared
           ;; explicitly since webmention endpoint discovery relies on it.
           org.jsoup/jsoup                {:mvn/version "1.15.2"}
           ;; Already on the classpath via Pedestal; declared explicitly since
           ;; the micropub endpoint relies on it for JSON in/output.
           metosin/jsonista               {:mvn/version "1.0.0"}}
 :aliases {:server {:main-opts ["-m" "blog.grays.web.service"]
                    :exec-fn   blog.grays.web.service/start!
                    ;; Datalevin needs these to access LMDB via java.nio on JDK 17+.
                    :jvm-opts  ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                                "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"]}
           :build  {:extra-paths ["dev/src"]
                    :extra-deps  {io.github.seancorfield/build-clj ; deprecated, apparently
                                  {:git/tag "v0.9.2" :git/sha "9c9f078"}}
                    :ns-default  build}

           ;; https://github.com/bhauman/clojure-mcp?tab=readme-ov-file#step-1-configure-your-target-projects-nrepl-connection
           :nrepl  {:extra-paths ["test" "src" "resources"]
                    :extra-deps  {nrepl/nrepl {:mvn/version "1.7.0"}}
                    ;; -Djdk.attach.allowAttachSelf lets nrepl interrupt runaway repl evals;
                    ;; the --add-opens flags let Datalevin access LMDB via java.nio on JDK 17+.
                    :jvm-opts    ["-Djdk.attach.allowAttachSelf"
                                  "--add-opens=java.base/java.nio=ALL-UNNAMED"
                                  "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"]
                    :main-opts   ["-m" "nrepl.cmdline" "--port" "7888"]}}}
